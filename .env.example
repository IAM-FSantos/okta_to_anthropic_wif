# Copy to .env and fill in real values. Never commit .env.

# --- Okta (steps 1-2: client assertion -> Okta access token) ---
# Okta org domain, without https:// (e.g. dev-123456.okta.com)
OKTA_DOMAIN=your-org.okta.com
# Custom authorization server ID (e.g. aus1a2b3c4d5e6f7g8h9, or "default")
OKTA_AUTH_SERVER_ID=default
# Client ID of the Okta API Services app using private_key_jwt auth
OKTA_CLIENT_ID=0oa_xxxxxxxxxxxxxxxx
# Key ID (kid) of the public key registered on the Okta app
OKTA_KEY_ID=your-key-id
# Optional: path to the PEM private key (default: workload_private_key.pem)
OKTA_PRIVATE_KEY_PATH=workload_private_key.pem
# Optional: scope to request (default: anthropic.access)
OKTA_SCOPE=anthropic.access

# --- Anthropic (steps 3-4: Okta token -> ephemeral Anthropic token) ---
ANTHROPIC_FEDERATION_RULE_ID=your-federation-rule-id
ANTHROPIC_ORGANIZATION_ID=your-organization-id
ANTHROPIC_SERVICE_ACCOUNT_ID=your-service-account-id
# Optional: scope the token to a specific workspace
# (required if the federation rule covers more than one workspace)
ANTHROPIC_WORKSPACE_ID=

# Optional: model used for the test call (default: claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
